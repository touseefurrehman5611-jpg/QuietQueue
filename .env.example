# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore, so your secrets never get committed.

# Your Supabase project URL and public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase key. This bypasses row level security — never put it in
# the browser and never commit it.
# Note: Supabase calls this key deprecated as of 2026; the replacement is a
# "sb_secret_..." key named SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your Groq API key, for the AI message route (get one at console.groq.com)
GROQ_API_KEY=your-grok-key

# Optional. Which model writes the message. This one returns plain text, which
# is what this route needs. See the comment in src/lib/ai.ts
# for how to list the models your own key can reach.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional. Leave this blank and the staff routes are open, which is what you
# want on localhost. Set it to any long random string and the five staff routes
# (list, next, done, cancel, speed) start returning 403 unless the request
# carries the same value in an "x-staff-key" header. Set it before you deploy
# this anywhere that is not your own machine.
# STAFF_KEY=
