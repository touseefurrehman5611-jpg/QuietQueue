# Copy to .env.local and fill in real values.
# NEVER commit .env.local. Every value below is a placeholder.

# Supabase project URL -> Project Settings -> Data API.
# Must be the https://<ref>.supabase.co API URL, NOT the dashboard settings page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to the browser. Found in Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only. Grants full access, bypasses RLS, NEVER prefix this with
# NEXT_PUBLIC_. Project Settings -> API Keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# UUID of the row in the `queues` table to operate on.
# Leave blank to fall back to the most recently created queue.
DEFAULT_QUEUE_ID=

# Absolute origin, used for canonical and Open Graph URLs.
# Leaving this unset falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Enables the AI turn-alert message instead of the built-in fallback.
# Without a key (or without credits) the app still works, just with canned text.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5